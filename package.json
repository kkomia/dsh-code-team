{
  "name": "dsh-project-dev",
  "version": "0.1.4",
  "description": "「项目开发模式」+ 开发进度看板：预设 persona/团队职责/看板守则，7 个 project_board_* 工具（含 prune 批量清理），只读快照路由与聊天内悬浮看板。",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./board-tools": "./board-tools.js",
    "./mode-guard": "./mode-guard.js",
    "./guard": "./guard.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "store.js",
    "board-tools.js",
    "mode-guard.js",
    "guard.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkomia/dsh-code-team.git"
  },
  "homepage": "https://github.com/kkomia/dsh-code-team#readme",
  "bugs": {
    "url": "https://github.com/kkomia/dsh-code-team/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-preset",
    "project-board",
    "task-board",
    "agent-team"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
